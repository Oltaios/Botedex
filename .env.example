# Copier ce fichier en ".env" et remplir les valeurs.
# Ne jamais committer le fichier ".env" (il est déjà dans le .gitignore).

# --- Discord ---
DISCORD_TOKEN=ton-token-de-bot-discord
# ID du channel principal du bot (spawns)
DISCORD_CHANNEL_ID=1234567890123456789

# --- Base de données ---
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=botedex

# --- Giphy ---
GIPHY_API_KEY=ta-cle-api-giphy
